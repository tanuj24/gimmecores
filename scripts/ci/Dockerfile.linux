# The Linux machine for scripts/ci-local.sh: what .github/workflows/ci.yml installs on
# ubuntu-latest, on Debian bookworm, plus the desktop app's build libraries. Built locally;
# nothing here is pushed anywhere.
FROM rust:1-bookworm

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      bubblewrap git python3 \
      libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev libssl-dev \
      build-essential pkg-config dpkg-dev desktop-file-utils \
 && rm -rf /var/lib/apt/lists/* \
 && rustup component add clippy rustfmt

# uv from its official image, pinned to the multi-platform digest (no `curl | sh`).
COPY --from=ghcr.io/astral-sh/uv:0.11.23@sha256:d0a0a753ab981624b49c97abc98821c1c09f4ca69d1ef5cee69c501be3d88479 \
     /uv /uvx /usr/local/bin/

# Tests run as an ordinary user, as on a real lender (the sandbox tests rely on it). The
# directories that become named volumes (build output and caches) are created here, owned by
# that user, so a new volume starts with the right owner.
RUN useradd -m -u 1000 tester \
 && mkdir -p /work/target /work/apps/desktop/target /cargo-home /home/tester/.cache \
 && chown -R tester:tester /work /cargo-home /home/tester/.cache
ENV CARGO_HOME=/cargo-home \
    PATH=/usr/local/cargo/bin:/cargo-home/bin:$PATH
USER tester
WORKDIR /work
