{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only GimmeCores' own commands.",
  "windows": ["main"],
  "permissions": [
    "allow-snapshot",
    "allow-activity",
    "allow-stop-task",
    "allow-set-lending",
    "allow-set-lend-modes",
    "allow-service-state",
    "allow-set-start-at-login",
    "allow-install-cli",
    "allow-stop-all",
    "allow-respond",
    "allow-revoke",
    "allow-open-pairing",
    "allow-start-pairing",
    "allow-start-pairing-nearby",
    "allow-set-discovery",
    "allow-confirm-pairing",
    "allow-unpair",
    "allow-set-trusted-mode",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
